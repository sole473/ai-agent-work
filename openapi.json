    "/auth/login": {
      "post": {
        "tags": [
          "认证"
        ],
        "summary": "管理员登录",
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string",
                    "example": "admin"
                  },
                  "password": {
                    "type": "string",
                    "format": "password"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功；设置 MUSIC_SESSION Cookie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "401": {
            "description": "账号或密码错误"
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "认证"
        ],
        "summary": "获取当前登录用户",
        "operationId": "getCurrentUser",
        "security": [
          {
            "MusicSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "当前用户；未登录时返回空对象"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "认证"
        ],
        "summary": "退出登录",
        "operationId": "logout",
        "security": [
          {
            "MusicSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "退出成功并清除 Cookie"
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": [
          "认证"
        ],
        "summary": "创建账号（仅 API 提供，前端不显示注册入口）",
        "operationId": "register",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 80,
                    "pattern": "^[a-z0-9._-]+$",
                    "example": "new-user"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "minLength": 8,
                    "maxLength": 72,
                    "description": "长度按 UTF-8 编码字节计算，最多 72 字节。"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "账号创建成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "400": {
            "description": "用户名格式错误或密码长度不符合要求"
          },
          "409": {
            "description": "用户名已存在"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "MusicSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "MUSIC_SESSION",
        "description": "先调用 POST /auth/login，成功后由 Apifox 保存并发送 Cookie。"
      }
    },
    "schemas": {
      "UserResponse": {
        "type": "object",
        "required": [
          "id",
          "username"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "账号 ID"
          },
          "username": {
            "type": "string"
          }
        }
      }
    }
  }
}
