# 复制为 .env，再填写自己的凭据。
# 填写应用连接 MySQL 使用的密码。
MYSQL_PASSWORD=
# 可选。填写 ACE-Step API 密钥；自部署 API 未启用鉴权时留空。
ACESTEP_API_KEY=
# ACE-Step 在本机运行时，Docker Desktop 和 Linux Docker 均可使用此地址。
ACESTEP_API_URL=http://host.docker.internal:8001
# Windows 本机 ACE-Step 的共享训练数据路径；Docker Compose 将对应项目子目录挂载到 API/Worker。
ACESTEP_TRAINING_HOST_DIR=B:/music-agent/models/ACE-Step-1.5/music-agent-data
# 自部署模型端任务的最长等待时间（秒）。
ACESTEP_TASK_TIMEOUT=3300
# 创作助手与歌词创作使用 DeepSeek 密钥。
DEEPSEEK_API_KEY=
# 创作助手使用支持联网搜索的 DeepSeek 模型。
DEEPSEEK_CHAT_MODEL=deepseek-flash
# 设置应用访问 Navidrome 的地址。
NAVIDROME_URL=http://navidrome:4533
# 填写用于搜索音乐库的 Navidrome 用户名。
NAVIDROME_USERNAME=
# 填写该 Navidrome 用户的密码。
NAVIDROME_PASSWORD=

# 可选。Nacos Client API 的地址和只读账号，留空时使用默认搜索超时。
NACOS_URL=
NACOS_USERNAME=
NACOS_PASSWORD=

# 可选。配置后，简历原文件会上传到指定 COS 桶和目录。
COS_BUCKET=rag-1344102550
COS_REGION=ap-guangzhou
COS_PREFIX=resume
COS_SECRET_ID=
COS_SECRET_KEY=
